{
  "name": "blueprint-monorepo",
  "private": true,
  "scripts": {
    "postinstall": "git update-index --skip-worktree .claude/specs/spec.md 2>/dev/null || true",
    "dev": "bun run --filter '@blueprint/backend' --filter '@blueprint/frontend' dev",
    "dev:down": "bun run --filter '@blueprint/backend' --filter '@blueprint/frontend' dev:down",
    "knip": "knip"
  },
  "workspaces": [
    "backend",
    "frontend",
    "utils/*"
  ],
  "devDependencies": {
    "@arthuroabrantes/maestro": "^0.1.2",
    "@eslint/js": "^9.38.0",
    "@types/bun": "^1.3.0",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.1.9",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "knip": "^5.85.0",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.46.2"
  }
}
