# Runtime
RUNTIME_ENVIRONMENT=development

# Bitwarden Secret Manager — replace with your organization's ID.
BWS_ORGANIZATION_ID=<your-bws-organization-id>

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blueprint_local_db
POSTGRES_USER=blueprint_local_user
POSTGRES_PASSWORD=blueprint_local_password

# Server
PORT=4000

# Local development — skips real OTP delivery and forces the OTP to "000000"
# so login/signup works without a configured provider. Never set to true in
# production.
MOCK_OTP=true
