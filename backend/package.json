{
  "name": "@blueprint/backend",
  "version": "0.1.0",
  "description": "Blueprint backend server",
  "scripts": {
    "test": "bun src/scripts/test.ts",
    "dev": "bun --env-file=local.env src/scripts/dev.ts",
    "dev:backend": "bun --env-file=local.env run --watch src/index.ts",
    "dev:db": "docker compose up -d postgres",
    "dev:down": "bun --env-file=local.env src/scripts/devDown.ts",
    "publish:image": "bun src/scripts/publishImage.ts",
    "lint": "bunx eslint .",
    "db:generate": "bun x drizzle-kit generate",
    "db:check": "bun x drizzle-kit check",
    "db:push": "bun --env-file=local.env src/scripts/drizzle.ts push",
    "db:migrate": "bun --env-file=local.env src/scripts/drizzle.ts migrate",
    "db:studio": "bun --env-file=local.env src/scripts/drizzle.ts studio",
    "db:validate": "bun src/scripts/validateDb.ts",
    "db:seed": "bun --env-file=local.env src/scripts/seed.ts",
    "db:down": "docker compose rm -sf postgres && docker volume rm $(docker volume ls -q --filter name=postgres_data)",
    "db:check-migrations": "bun src/scripts/checkMigrations.ts",
    "validate:schemas": "bun src/scripts/validateSchemas.ts",
    "validate:query-imports": "bun src/scripts/validateQueryImports.ts",
    "validate:test-only": "bun src/scripts/validateTestOnly.ts",
    "validate:db-usage": "bun src/scripts/validateDbUsage.ts",
    "validate:sql-usage": "bun src/scripts/validateSqlUsage.ts",
    "postinstall": "bun -e \"import { install } from 'cloudflared'; import { bin } from 'cloudflared/lib/constants'; await install(bin)\""
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "cloudflared": "^0.7.1",
    "drizzle-kit": "^0.31.8",
    "pg": "^8.16.3"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@blueprint/api-utils": "workspace:*",
    "@blueprint/async-arg-utils": "workspace:*",
    "@blueprint/crypto-utils": "workspace:*",
    "@blueprint/enum-utils": "workspace:*",
    "@blueprint/error-utils": "workspace:*",
    "@blueprint/script-utils": "workspace:*",
    "@blueprint/time-utils": "workspace:*",
    "@blueprint/type-utils": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "@transcend-io/secret-value": "^1.2.3",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.19"
  }
}
